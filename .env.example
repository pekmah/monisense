NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
LOG_FORMAT=pretty
DATABASE_URL=postgres://postgres:postgres@db:5432/finance_ai
API_SECRET=change_me
GEMMA_BASE_URL=http://host.docker.internal:11434
GEMMA_MODEL=gemma:7b
GEMMA_TIMEOUT_MS=12000
REQUEST_BODY_LIMIT_BYTES=16384
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
ALLOW_MOCK_GEMMA=true
