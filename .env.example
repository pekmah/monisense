NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
LOG_FORMAT=pretty
DATABASE_URL=postgres://app_user:replace_with_strong_password@db:5432/finance_ai
DATABASE_ADMIN_URL=postgres://postgres:replace_with_strong_admin_password@db:5432/finance_ai
API_SECRET=replace_with_a_long_random_secret
GEMMA_BASE_URL=http://host.docker.internal:11434
GEMMA_MODEL=gemma:7b
GEMMA_TIMEOUT_MS=60000
REQUEST_BODY_LIMIT_BYTES=16384
BULK_REQUEST_BODY_LIMIT_BYTES=5242880
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
BULK_RATE_LIMIT_MAX_REQUESTS=1200
ALLOW_MOCK_GEMMA=true
